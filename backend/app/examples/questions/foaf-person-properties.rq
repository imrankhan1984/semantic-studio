# rdfs:domain says which class a property describes: these are the ones that describe a Person.
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?property ?name WHERE {
  ?property rdfs:domain foaf:Person .
  OPTIONAL { ?property rdfs:label ?name }
}
ORDER BY ?property
