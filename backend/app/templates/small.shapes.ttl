@prefix {{prefix}}: <{{base}}> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

{{prefix}}:CheckMyModel a sh:NodeShape ;
    rdfs:label "Check my model"@{{lang}} ;
    sh:targetClass owl:Class ;
    sh:property [
        sh:path rdfs:label ;
        sh:qualifiedValueShape [ sh:languageIn ( "{{lang}}" ) ] ;
        sh:qualifiedMinCount 1
    ] , [
        sh:path [ sh:alternativePath ( skos:definition rdfs:comment ) ] ;
        sh:minCount 1
    ] .

{{prefix}}:PersonRules a sh:NodeShape ;
    rdfs:label "Person rules"@{{lang}} ;
    sh:targetClass {{prefix}}:Person ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] , [
        sh:path {{prefix}}:memberOf ;
        sh:minCount 1 ;
        sh:class {{prefix}}:Organization
    ] .

{{prefix}}:OrganizationRules a sh:NodeShape ;
    rdfs:label "Organization rules"@{{lang}} ;
    sh:targetClass {{prefix}}:Organization ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1
    ] .
