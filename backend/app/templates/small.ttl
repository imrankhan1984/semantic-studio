@prefix {{prefix}}: <{{base}}> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<{{ontology}}> a owl:Ontology ;
    rdfs:label "{{name}}"@{{lang}} .

{{prefix}}:Person a owl:Class ;
    rdfs:label "Person"@{{lang}} ;
    rdfs:comment "A human being."@{{lang}} .

{{prefix}}:Organization a owl:Class ;
    rdfs:label "Organization"@{{lang}} ;
    rdfs:comment "A group of people with a shared purpose."@{{lang}} .

{{prefix}}:memberOf a owl:ObjectProperty ;
    rdfs:label "member of"@{{lang}} ;
    rdfs:domain {{prefix}}:Person ;
    rdfs:range {{prefix}}:Organization .

{{prefix}}:alice a {{prefix}}:Person, owl:NamedIndividual ;
    rdfs:label "Alice"@{{lang}} .

{{prefix}}:acme a {{prefix}}:Organization, owl:NamedIndividual ;
    rdfs:label "Acme"@{{lang}} .
