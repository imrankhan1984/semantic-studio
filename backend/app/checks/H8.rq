# Classes under a person or an organization class, so the report can see which are named for a role (customer, supplier, ...): a role is played for a while, a kind is for life.
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX ss: <urn:semantic-studio:check:>
SELECT DISTINCT ?iri ?parent WHERE {
  VALUES ?type { owl:Class rdfs:Class }
  ?iri a ?type ; rdfs:subClassOf+ ?parent .
  FILTER(isIRI(?iri) && isIRI(?parent) && ss:own(?iri))
  BIND(LCASE(REPLACE(STR(?parent), "^.*[#/]", "")) AS ?parentName)
  FILTER(?parentName IN ("person", "organization", "organisation"))
}
ORDER BY ?iri ?parent
