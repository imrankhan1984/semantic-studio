# Deprecated terms still in use: an individual of it, a statement by it, or a class under it.
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX ss: <urn:semantic-studio:check:>
SELECT DISTINCT ?iri ?user ?how WHERE {
  ?iri owl:deprecated ?flag .
  FILTER(isIRI(?iri) && ss:own(?iri) && STR(?flag) IN ("true", "1"))
  {
    ?user a ?iri . BIND("one" AS ?how)
  } UNION {
    ?user ?iri ?value . BIND("uses" AS ?how)
  } UNION {
    ?user rdfs:subClassOf ?iri . BIND("under" AS ?how)
  }
  FILTER(isIRI(?user))
  FILTER NOT EXISTS { ?user owl:deprecated ?userFlag . FILTER(STR(?userFlag) IN ("true", "1")) }
}
ORDER BY ?iri ?user
