# Class names that look plural: a class names one member, so its name is singular (the report leaves out the singular words of manifest.json, such as series and species).
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX ss: <urn:semantic-studio:check:>
SELECT DISTINCT ?iri ?name WHERE {
  VALUES ?type { owl:Class rdfs:Class }
  ?iri a ?type .
  BIND(REPLACE(STR(?iri), "^.*[#/]", "") AS ?name)
  FILTER(isIRI(?iri) && ss:own(?iri) && REGEX(?name, "[a-z][a-z]s$") && !REGEX(?name, "(ss|us|is|ics|ous)$"))
}
ORDER BY ?iri
