# Version IRIs that are not the ontology IRI, a slash and the version.
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX ss: <urn:semantic-studio:check:>
SELECT ?iri ?versionIri ?version WHERE {
  ?iri a owl:Ontology ;
       owl:versionIRI ?versionIri ;
       owl:versionInfo ?version .
  FILTER(isIRI(?iri) && STR(?versionIri) != CONCAT(STR(?iri), "/", STR(?version)))
}
ORDER BY ?iri
