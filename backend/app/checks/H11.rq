# Attributes whose text is another individual's name: perhaps a relationship to that individual, written as its label.
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX ss: <urn:semantic-studio:check:>
SELECT ?iri ?subject ?value ?individual WHERE {
  VALUES ?type { owl:DatatypeProperty owl:AnnotationProperty rdf:Property }
  ?iri a ?type .
  ?subject ?iri ?value .
  FILTER(isLiteral(?value) && ss:own(?iri))
  ?individual rdfs:label|skos:prefLabel ?name .
  FILTER(LCASE(STR(?name)) = LCASE(STR(?value)) && ?individual != ?subject && ss:own(?individual) && !ss:term(?individual))
}
ORDER BY ?iri ?subject
