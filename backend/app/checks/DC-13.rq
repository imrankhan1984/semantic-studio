# Classes and concepts more than four levels below the top (the report counts the longest path in Python, from the tree's forests; this query counts ancestors).
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX ss: <urn:semantic-studio:check:>
SELECT ?iri (COUNT(DISTINCT ?above) AS ?depth) WHERE {
  { ?iri rdfs:subClassOf+ ?above . } UNION { ?iri skos:broader+ ?above . }
  FILTER(isIRI(?iri) && isIRI(?above) && ss:own(?iri) && ss:own(?above))
}
GROUP BY ?iri
HAVING (COUNT(DISTINCT ?above) > 4)
ORDER BY DESC(?depth) ?iri
