# Terms with no definition (skos:definition, rdfs:comment or dcterms:description); ?note says whether a note stands in for one.
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX ss: <urn:semantic-studio:check:>
SELECT DISTINCT ?iri ?note WHERE {
  VALUES ?type { owl:Class rdfs:Class owl:ObjectProperty owl:DatatypeProperty owl:AnnotationProperty rdf:Property skos:Concept sh:NodeShape }
  ?iri a ?type .
  FILTER(isIRI(?iri) && ss:own(?iri))
  FILTER NOT EXISTS { ?iri skos:definition|rdfs:comment|dcterms:description ?definition . }
  OPTIONAL { ?iri skos:note|skos:scopeNote|skos:editorialNote|skos:example ?note . }
}
ORDER BY ?iri
