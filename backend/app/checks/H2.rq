# Every domain and range of the document's own properties: each adds a type to whatever uses the property, and never refuses data (the report reads a domain through axioms.domain_of, and adds what the last reasoning run concluded from it).
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX ss: <urn:semantic-studio:check:>
SELECT DISTINCT ?iri ?how ?class WHERE {
  { ?iri rdfs:domain ?class . BIND(rdfs:domain AS ?how) }
  UNION
  { ?iri rdfs:range ?class . BIND(rdfs:range AS ?how) }
  FILTER(isIRI(?iri) && ss:own(?iri))
  FILTER EXISTS { VALUES ?type { owl:ObjectProperty owl:DatatypeProperty rdf:Property } ?iri a ?type . }
}
ORDER BY ?iri ?how ?class
